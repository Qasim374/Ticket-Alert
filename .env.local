# --- Real live scores from API-Football (api-football.com) ---
# Get a free key at https://dashboard.api-football.com/ and paste it here.
# Leave blank to run in DEMO mode (fake goals so you can test notifications).
API_FOOTBALL_KEY=860ced837b2e2bc06b37040afe10703a

# Which league to follow. 1 = World Cup. Use "all-live" to follow every live
# match anywhere (good for testing when no World Cup game is on).
API_FOOTBALL_LEAGUE=1

# --- Ticket alerts (Ticketmaster Discovery API) ---
# Get a free key at https://developer.ticketmaster.com/ and paste it here.
# Leave blank to run ticket alerts in DEMO mode (fake availability).
TICKETMASTER_API_KEY=fJoUWVXYGCc6d4iVIJcDMXaPv5aXnxjk

# How often to check ticket availability, in ms (default 180000 = 3 min).
TICKET_CHECK_INTERVAL_MS=180000

# How often to check scores, in ms. The FREE plan allows only ~100 calls/day,
# so don't go too low. 90000 (90s) ≈ 960 calls over a 24h day — still over the
# free cap, so for the free plan only run the app during matches you care about.
CHECK_INTERVAL_MS=90000
